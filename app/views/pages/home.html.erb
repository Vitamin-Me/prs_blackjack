<div class="flex flex-col items-center justify-center py-2">
  <main class="flex flex-col items-center justify-center w-full flex-1 px-20 text-center">
    <p class="mt-3 text-2xl">
        <p> Dealer</p>
      <code class="p-3 font-mono text-lg bg-gray-100 rounded-md xl top">
        t(O-O)t
      </code>
    </p>

  <div class="grid grid-cols-3 w-full">
    <div class="flex col-start-2 justify-center gap-4">
      <% @dealer_cards.each do |card| %>
        <%= render "card", card: card %>
      <% end %>
    </div>

    <div class="grid col-start-3 border self-justify-right px-6 text-4xl font-texturina">
      <div>
        Cards left in deck: <%= @cards_remaining %>
      </div>
        Test
      </div>
  </div>

    <div class="text-4xl font-texturina">
        <%= @dealer_score %>
    </div>

    <%# Separates the dealer from the player #%>
    <hr class="my-6 border-black-300 w-full" />

    <div class="text-4xl font-texturina">
        <%= @player_score %>
    </div>

    <div class="grid grid-cols-3 w-full">
      <div class="flex col-start-2 justify-center gap-4">
        <% @player_cards.each do |card| %>
          <%= render "card", card: card %>
        <% end %>
      </div>

      <div class="col-start-3 flex flex-col gap-2 justify-self-center self-center">
        <button type="button" class="h-10 w-20 border">
          Stand
        </button>

        <div class="bg-black text-white px-4 py-2 rounded-md hover:bg-white hover:text-black">
          <%= button_to "Hit", pages_hit_path, method: :post %>
        </div>
      </div>
      
    </div>

</main>
    
</div>

