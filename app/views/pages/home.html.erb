<div class="flex flex-col items-center justify-center py-2">
  <main class="flex flex-col items-center justify-center w-full flex-1 px-20 text-center">
    <div class="grid grid-cols-3 w-full">
      <div class="flex col-start-1 col-span-2 gap-4 justify-end mr-20">
        <% @dealer_cards.each_with_index do |card, index| %>
            <% if @game_stage == 1%>
              <%= render "card_back" %>
            <% elsif index == 1 and not @dealer_revealed %>
              <%= render "card_back" %>
            <% else %>
              <%= render "card", card: card %>
            <% end %>
        <% end %>
      </div>

      <div class="flex col-start-3 bg-gray-500 rounded-xl px-6 text-2xl items-center font-texturina">
        <div class="flex flex-col gap-4 items-start text-white max-h-64 w-full overflow-y-auto">
          <% @game_messages.each do |line| %>
            <div> > <%= line %> </div> 
          <% end %>
        </div>
      </div>

      <div class="flex col-start-1 font-texturina text-4xl">
            $<%= session[:dealer_balance]%>
      </div> 

      <div class="col-start-2 text-5xl font-texturina">
            <% if @game_stage == 1 %>
          ~
        <% else %>
          <%= @dealer_score %>
        <% end %>
      </div>

      <%# Separates the dealer from the player #%>
      <hr class="my-6 col-span-3 border-black-300 w-full" />

      <div class="flex col-start-1 font-texturina text-4xl">
            $<%= session[:player_balance] %>
      </div> 

      <div class="col-start-2 text-5xl font-texturina">
        <% if @game_stage == 1 %>
          ~
        <% else %>
          <%= @player_score %>
        <% end %>
      </div>

      <div class="flex col-start-1 col-span-2 gap-4 justify-end mr-20">
        <% @player_cards.each_with_index do |card, index| %>
          <% if @game_stage == 1 %>
            <%= render "card_back" %>
          <% else %>
            <%= render "card", card: card %>
          <% end %>
        <% end %>
      </div>


      <div class="grid col-start-3 grid-cols-2 bg-gray-500 rounded-xl px-6 text-2xl items-center text-center font-texturina"> 
        <div class= "flex flex-col pb-13 items-center gap-5">
          <%= form_with url: pages_start_round_path, class: "flex flex-col gap-5 px-4" do |f| %>
            <%= f.label :player_bet, "Your bet:", class: "text-2xl text-white" %>
            <%= f.number_field :player_bet, required: true, min: 1, hidden: @game_stage != 1, class: "bg-white w-40 text-center rounded-md p-2", placeholder: "$0"  %>
            <div class=" <%= 'hidden' if @game_stage == 1 %> text-white text-4xl"> $ <%= @player_bet %> </div>
            
            <%= f.submit "Place Bet", disabled: @game_stage != 1 , class: "w-40 bg-black text-white px-4 py-2 rounded-md hover:bg-white hover:text-black
              disabled:bg-gray-400 disabled:text-gray-700 disabled:cursor-not-allowed" %>

          <% end %>
            <div class="col-start-1 items-center">
              <%= button_to "New Round", pages_start_game_path, disabled: @game_stage != 3, class: "w-40 bg-black text-white px-2 py-2 rounded-md hover:bg-white hover:text-black
                disabled:bg-gray-400 disabled:text-gray-700 disabled:cursor-not-allowed" %>
            </div>   
          
        </div>
          <div class="flex flex-col col-start-2 gap-5">
            <%= button_to "Stand", pages_stand_path, method: :post, disabled: @game_stage != 2, 
            class: "w-40 bg-black text-white px-4 py-2 rounded-md hover:bg-white hover:text-black disabled:bg-gray-400 disabled:text-gray-700 disabled:cursor-not-allowed" %>

            <%= button_to "Hit", pages_hit_path, method: :post, disabled: @game_stage != 2, 
            class: "w-40 bg-black text-white px-4 py-2 rounded-md hover:bg-white hover:text-black disabled:bg-gray-400 disabled:text-gray-700 disabled:cursor-not-allowed" %>

            <%= button_to "Split", pages_hit_path, method: :post, disabled: true, 
            class: "w-40 bg-black text-white px-4 py-2 rounded-md hover:bg-white hover:text-black disabled:bg-gray-400 disabled:text-gray-700 disabled:cursor-not-allowed" %>

        </div>  
      </div>


      </div>

    </div>

  </main>
    
</div>

